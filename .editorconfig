# SmartSOC Enterprise - style uniforme entre IntelliJ IDEA et VS Code
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 120

[*.{js,jsx,ts,tsx,json,css,scss,html}]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[*.{xml,pom}]
indent_size = 4

[*.py]
indent_size = 4
max_line_length = 100

[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd,ps1}]
end_of_line = crlf

[Makefile]
indent_style = tab

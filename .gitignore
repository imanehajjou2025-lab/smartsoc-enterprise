# ======================================
# SmartSOC Enterprise - .gitignore
# Monorepo : Java/Maven + Node + Python
# ======================================

# --- Secrets & environnement (JAMAIS commités) ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks
secrets/

# --- Java / Maven (backend) ---
target/
*.class
*.jar
*.war
*.nar
*.ear
.mvn/wrapper/maven-wrapper.jar
release.properties
pom.xml.releaseBackup
pom.xml.versionsBackup

# --- Node.js (frontend) ---
node_modules/
dist/
build/
.vite/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache

# --- Python (ai-service) ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml

# --- Modèles ML & datasets (trop lourds pour Git) ---
*.pkl
*.joblib
*.onnx
*.h5
*.parquet
datasets/
models/artifacts/

# --- IDE ---
.idea/
*.iml
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp

# --- OS ---
Thumbs.db
Desktop.ini
.DS_Store

# --- Docker / logs / divers ---
*.log
logs/
tmp/
.docker/
docker/volumes/

# --- Rapports d'outils sécurité & tests (générés) ---
.scannerwork/
dependency-check-report.html
trivy-report.*
coverage/
test-results/

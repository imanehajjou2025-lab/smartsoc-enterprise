# ==========================================================
# SmartSOC Enterprise - Modèle de variables d'environnement
# ==========================================================
# Copier ce fichier en `.env` et renseigner les valeurs.
# Le fichier `.env` est ignoré par Git : NE JAMAIS le commiter.
# Ce modèle sera enrichi au fur et à mesure des jalons.
# ==========================================================

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=smartsoc
POSTGRES_USER=smartsoc
POSTGRES_PASSWORD=changeme

# --- Backend Spring Boot ---
BACKEND_PORT=8080
# Genere un secret robuste :  openssl rand -base64 48
JWT_SECRET=changeme-generate-a-256-bit-secret
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=7

# --- Compte administrateur initial (cree au premier demarrage) ---
SMARTSOC_ADMIN_USERNAME=admin
SMARTSOC_ADMIN_EMAIL=admin@smartsoc.local
SMARTSOC_ADMIN_PASSWORD=changeme-strong-password-12-chars-min

# --- Ingestion des alertes (webhooks des outils SOC) ---
# Cle d'API attendue dans le header X-API-Key. Vide = ingestion desactivee.
# Genere une cle robuste :  openssl rand -hex 32
SMARTSOC_INGEST_API_KEY=

# --- Lecture par les outils de l'assistant IA (ADR-008) ---
# Cle d'API dediee, GET uniquement (alertes, MITRE...). Vide = l'assistant
# ne peut pas s'authentifier pour ses outils. A donner au service IA externe.
SMARTSOC_AI_TOOLS_API_KEY=

# --- Frontend ---
# En conteneur, Spring Boot sert lui-meme l'UI React sur le port 8080
# (ADR-007, sans Nginx) : pas de port frontend dedie.
# Le serveur de DEV Vite (npm run dev) utilise 5173 et proxifie /api + /ws
# vers le backend. Aucune URL backend n'est codee en dur.

# --- Integration IA (ADR-008) ---
# simulation (defaut) = stubs embarques, plateforme demontrable seule ;
# live = clients vers les vrais services IA (developpes hors depot).
SMARTSOC_AI_MODE=simulation
# Classifieur TP/FP (contrat : docs/integration/ai-classifier-api.yaml)
SMARTSOC_AI_CLASSIFIER_URL=http://localhost:8000
SMARTSOC_AI_CLASSIFIER_API_KEY=
# Assistant conversationnel (contrat : docs/integration/ai-assistant-api.yaml)
SMARTSOC_AI_ASSISTANT_URL=http://localhost:8001
SMARTSOC_AI_ASSISTANT_API_KEY=

# --- Connecteurs SOC (ADR-014) ---
# simulation (defaut) = stub embarque, plateforme demontrable seule ;
# live = vraie API du connecteur ; disabled = aucune tentative.
# Passer un mode a "live" sans ses identifiants ci-dessous echoue au
# premier cycle, jamais silencieusement.

# Wazuh -- compte API dedie en LECTURE SEULE (ADR-015), jamais le compte admin
SMARTSOC_CONNECTORS_WAZUH_MODE=simulation
SMARTSOC_CONNECTORS_WAZUH_URL=https://localhost:55000
SMARTSOC_CONNECTORS_WAZUH_USERNAME=
SMARTSOC_CONNECTORS_WAZUH_PASSWORD=

# Wazuh -- sous-contexte actions (phase 5, EFFET REEL) : compte DEDIE
# distinct de la lecture ci-dessus, portee minimale (redemarrage +
# active-response uniquement, jamais le compte lecture seule elargi)
SMARTSOC_CONNECTORS_WAZUH_ACTIONS_MODE=simulation
SMARTSOC_CONNECTORS_WAZUH_ACTIONS_USERNAME=
SMARTSOC_CONNECTORS_WAZUH_ACTIONS_PASSWORD=

# Indexer Wazuh (OpenSearch) -- source des vulnerabilites (phase 1.3) et
# de la recherche d'evenements Hunting (phase 4)
SMARTSOC_CONNECTORS_OPENSEARCH_MODE=simulation
SMARTSOC_CONNECTORS_OPENSEARCH_URL=https://localhost:9200
SMARTSOC_CONNECTORS_OPENSEARCH_USERNAME=
SMARTSOC_CONNECTORS_OPENSEARCH_PASSWORD=

# MISP -- cle API dediee "Read only", compte dedie recommande (jamais admin)
SMARTSOC_CONNECTORS_MISP_MODE=simulation
SMARTSOC_CONNECTORS_MISP_URL=https://localhost
SMARTSOC_CONNECTORS_MISP_API_KEY=

# VirusTotal -- reputation a la demande d'un analyste uniquement (jamais
# sur le flux). Quota strict en offre gratuite : 4 requetes/min, 500/jour.
SMARTSOC_CONNECTORS_VIRUSTOTAL_MODE=simulation
SMARTSOC_CONNECTORS_VIRUSTOTAL_API_KEY=
